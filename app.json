{
  "expo": {
    "name": "exceed",
    "slug": "exceed",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./app/assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./app/assets/background.png",
      "resizeMode": "cover",
      "backgroundColor": "#373598"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "club.exceedtoastmasters"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/icon.png",
        "backgroundColor": "#E2E1E1"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.exceedtoastmastersclub.exceed"
    },
    "web": {
      "favicon": "./app/assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourceslnReleaseBuilds": true,
            "useLegacyPackaging": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d338aeaa-7f6f-4fea-858b-41067e9d4b23"
      }
    }
  }
}
